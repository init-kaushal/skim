{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/skim read-hook", "timeout": 60 } ] },
      { "matcher": "Grep", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/skim grep-hook", "timeout": 60 } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/skim bash-hook", "timeout": 60 } ] }
    ]
  }
}
